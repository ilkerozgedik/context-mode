{
  "name": "context-mode",
  "version": "1.0.169",
  "type": "module",
  "description": "Context-mode MCP server optimized for 1MCP.",
  "author": "Mert Koseoğlu",
  "license": "Elastic-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "1mcp",
    "context-window",
    "sandbox",
    "code-execution",
    "fts5",
    "bm25"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ilkerozgedik/context-mode"
  },
  "homepage": "https://github.com/ilkerozgedik/context-mode#readme",
  "bugs": "https://github.com/ilkerozgedik/context-mode/issues",
  "bin": {
    "context-mode": "./server.bundle.mjs"
  },
  "files": [
    "server.bundle.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild src/server.ts --bundle --platform=node --target=node18 --format=esm --outfile=server.bundle.mjs --external:better-sqlite3 --external:turndown --external:turndown-plugin-gfm --external:@mixmark-io/domino --minify",
    "dev": "npx tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "better-sqlite3": "^12.6.2",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@clack/prompts": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.11",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.27.3",
    "picocolors": "^1.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18",
    "zod": "^3.25.0"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
  "engines": {
    "node": ">=22.5.0"
  }
}
